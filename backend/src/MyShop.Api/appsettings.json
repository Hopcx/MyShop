{
  "Logging": { "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning", "Microsoft.EntityFrameworkCore": "Warning" } },
  "AllowedHosts": "*",
  "App": { "FrontendUrl": "http://localhost:3000", "CorsOrigins": [ "http://localhost:3000" ] },
  "Database": { "Provider": "SqlServer", "AutoCreate": false },
  "ConnectionStrings": { "Shop": "", "Redis": "" },
  "Elasticsearch": { "Url": "", "Index": "products" },
  "Jwt": { "Issuer": "myshop", "Audience": "myshop-clients", "SigningKey": "", "AccessTokenMinutes": 15, "RefreshTokenDays": 14 },
  "Pricing": { "FreeShippingThreshold": 500000, "FlatShippingFee": 30000 },
  "Webhooks": { "ToleranceSeconds": 300, "EnableMockPay": false, "Secrets": {} },
  "RateLimit": { "GlobalPerMinute": 600, "AuthPerMinute": 10, "CheckoutPerMinute": 20 },
  "Security": { "Tls13Only": false },
  "Outbox": { "Enabled": true },
  "Seed": { "Enabled": false }
}
